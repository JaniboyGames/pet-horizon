# Copy to .env and fill in your own SMTP provider settings. Never commit real passwords.
PORT=3000
NODE_ENV=production
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
MAIL_FROM=your-email@gmail.com
# Optional alternative: SMTP_URL=smtps://user:password@host:465

# Owner/admin account email (the shipped account is already hashed in accounts.json).
ADMIN_EMAIL=janseibt16@gmail.com
# GAME_API_KEY must be a long random secret used only by your Roblox server.
GAME_API_KEY=replace-with-a-long-random-secret
# ADMIN_KEY is kept only for legacy integrations; admin web actions use the admin session.
ADMIN_KEY=replace-with-a-long-random-secret
